# StemMatch .gitignore
# Covers the approved stack: Python/FastAPI, Node.js/TypeScript/React,
# Terraform, Docker, and local tooling. Patterns that end in "/" match
# directories only. Avoid adding bare generic directory names (e.g. "lib/",
# "env/", "ENV/", "var/") because they would also match source folders
# anywhere in the monorepo. Note: Git on Windows matches case-insensitively.

# ---------------------------------------------------------------------------
# Environment files and local secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.p12
*.pfx
.secrets/
secrets.local.*

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
.installed.cfg
pip-log.txt
pip-delete-this-directory.txt
__pypackages__/
.pdm-python
.pdm-build/
.pypirc

# Virtual environments
# ".venv" (no trailing slash) ignores both a .venv directory and a .venv file
# (some tools write a .venv file pointing to an external environment).
.venv
venv/
env.bak/
venv.bak/

# Python tooling caches
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.hypothesis/
.tox/
.nox/
.pyre/
.pytype/
.ipynb_checkpoints/
cython_debug/

# ---------------------------------------------------------------------------
# Node.js / npm / TypeScript / frontend tooling
# ---------------------------------------------------------------------------
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
*.tsbuildinfo
.eslintcache
.stylelintcache
.vite/
.parcel-cache/

# ---------------------------------------------------------------------------
# Build outputs
# These rules are intended ONLY for generated build artifacts (compiled
# frontend bundles, transpiled TypeScript, Python wheels/sdists, docs builds).
# They match a directory with these names at any depth, so never use
# build/, dist/ or out/ as names for hand-written source directories.
# ---------------------------------------------------------------------------
dist/
build/
out/
docs/_build/
/site/

# ---------------------------------------------------------------------------
# Test and coverage reports
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.lcov
lcov.info
nosetests.xml

# ---------------------------------------------------------------------------
# Terraform
# (.terraform.lock.hcl is intentionally NOT ignored; it should be committed.)
# ---------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ---------------------------------------------------------------------------
# Docker and local service data
# Keep local database/broker volumes out of the repo (and ideally out of
# OneDrive; see docs/architecture.md).
# ---------------------------------------------------------------------------
docker-compose.override.yml
compose.override.yml
.docker-data/
/.data/
*.rdb
*.aof

# ---------------------------------------------------------------------------
# Logs and temporary files
# ---------------------------------------------------------------------------
*.log
*.pid
*.tmp
.cache/

# ---------------------------------------------------------------------------
# OS and editor files
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---------------------------------------------------------------------------
# Claude Code local (per-user) settings
# ---------------------------------------------------------------------------
.claude/settings.local.json
